# ── Obsidian GitHub Analytics — environment ──────────────────────────────
# Copy to ".env.local" for local dev, or set these in Vercel → Project → Settings → Environment Variables.

# REQUIRED: GitHub Personal Access Token (server-only, never exposed to client).
# Recommended scopes (classic): read:user, repo, read:org
#   - read:user  → profile, followers, orgs
#   - repo       → private contribution counts
#   - read:org   → organization contributions
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED: the GitHub username these cards represent (your profile).
GITHUB_USERNAME=your-github-username

# OPTIONAL: allow ?username= override so the service can render any public profile.
# Default false → service only ever serves GITHUB_USERNAME (protects your PAT rate limit).
ALLOW_ANY_USER=false

# OPTIONAL: CDN cache freshness (seconds). Default 3600 (1h).
CACHE_SECONDS=3600

# OPTIONAL: stale-while-revalidate window (seconds). Default 86400 (24h).
SWR_SECONDS=86400

# OPTIONAL: best-effort per-IP rate limit (requests/min) for uncached requests. Default 30.
RATE_LIMIT_RPM=30
